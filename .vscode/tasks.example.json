{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start dev server",
      "type": "process",
      "command": "pnpm",
      "args": ["run", "dev"],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "starting dev server",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "stop dev server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "$p = (Get-NetTCPConnection -LocalPort 5173 -State Listen).OwningProcess; if ($p) { taskkill /PID $p /F /T }"
      ],
      "problemMatcher": []
    }
  ]
}
