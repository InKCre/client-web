{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "experimentalDecorators": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../../apps/client-web/src/*"],
      "@inkcre/core": ["../../packages/core/src/index.ts"],
      "@inkcre/core/*": ["../../packages/core/src/*"],
      "@host/*": ["../../apps/client-web/src/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.vue"]
}
