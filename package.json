{
  "name": "@inkcre/web-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs web",
    "dev:webext": "node scripts/dev.mjs webext",
    "dev:status": "svc dev status --repo . --json",
    "dev:stop": "node scripts/dev-stop.mjs",
    "db:ready": "node scripts/database-runtime.mjs ready",
    "db:reset": "node scripts/database-runtime.mjs reset --yes",
    "contract:sync": "node scripts/sync-database-contract.mjs",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm -r --filter './extensions/*' dev\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:type-aware": "oxlint --type-aware .",
    "audit:dependencies": "pnpm audit --audit-level high",
    "type-check": "pnpm check:workspace && pnpm check:runtime && pnpm check:database && pnpm -r run type-check",
    "type-check:ts7": "node node_modules/@typescript/native/bin/tsc --project packages/core/tsconfig.json --noEmit",
    "check:runtime": "node scripts/check-local-runtime-contract.mjs",
    "check:database": "node scripts/check-database-contract.mjs",
    "check:workspace": "node scripts/check-workspace-contract.mjs",
    "check:package": "node scripts/check-package-contract.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:runtime": "vitest run --project runtime",
    "test:e2e": "pnpm test:e2e:web && pnpm test:e2e:webext",
    "test:e2e:web": "node scripts/test-e2e.mjs",
    "test:e2e:webext": "node scripts/test-webext-e2e.mjs",
    "build": "pnpm check:workspace && pnpm -r run build && pnpm check:package",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test:unit && pnpm build",
    "ci": "pnpm check && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-vue": "6.0.3",
    "concurrently": "^9.0.0",
    "happy-dom": "20.11.1",
    "jose": "6.1.2",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.12.0",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "22.22.3",
    "pnpm": "10.26.2"
  },
  "packageManager": "pnpm@10.26.2"
}
