{
  "name": "@inkcre/web-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "22.22.3",
    "pnpm": "10.26.2"
  },
  "scripts": {
    "dev": "pnpm --filter @inkcre/client-web dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm -r --filter './extensions/*' dev\"",
    "build": "pnpm --filter @inkcre/core build && pnpm --filter @inkcre/client-web build",
    "build:ext": "pnpm -r --filter './extensions/*' build",
    "build:all": "pnpm build && pnpm build:ext",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "~5.8.0"
  }
}
