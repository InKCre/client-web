{
  "name": "@inkcre/client-webext",
  "description": "InKCre's Web extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "crx": "wxt build && crx3 -p .output/inkcre.pem -o .output/inkcre-$npm_package_version-chrome.crx .output/chrome-mv3",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ai-sdk/vue": "^2.0.86",
    "@iconify/json": "^2.2.239",
    "@inkcre/core": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "@unocss/preset-icons": "^66.5.1",
    "@unocss/reset": "^66.5.1",
    "@vueuse/core": "^13.9.0",
    "@vueuse/shared": "^13.9.0",
    "@wxt-dev/storage": "^1.2.0",
    "ai": "^5.0.81",
    "vue": "^3.5.21",
    "vue-demi": "^0.14.10",
    "vue-markdown-render": "^2.3.0",
    "webext-bridge": "^6.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@rollup/rollup-win32-x64-msvc": "^4.55.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.5.0",
    "@types/wink-tokenizer": "^4.0.6",
    "@unocss/preset-uno": "^66.5.1",
    "@vitest/ui": "^4.0.5",
    "@wxt-dev/module-vue": "^1.0.2",
    "crx3": "^1.1.3",
    "happy-dom": "^20.0.10",
    "sass": "^1.93.3",
    "typescript": "^5.9.2",
    "unocss": "^66.5.1",
    "vitest": "^4.0.5",
    "vue-tsc": "^3.0.6",
    "wxt": "^0.20.6"
  }
}
