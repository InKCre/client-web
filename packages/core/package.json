{
  "name": "@inkcre/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^2.84.0",
    "zod": "^4.1.12",
    "zod-class": "^0.0.18",
    "ml-matrix": "^6.12.1",
    "graphology": "^0.26.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~5.8.0",
    "vue": "^3.5.18"
  }
}
