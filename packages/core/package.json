{
  "name": "@inkcre/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.38",
    "@ai-sdk/google": "^2.0.24",
    "@ai-sdk/openai": "^2.0.56",
    "@ai-sdk/openai-compatible": "^1.0.24",
    "@supabase/postgrest-js": "^2.84.0",
    "dayjs": "^1.11.0",
    "graphology": "^0.26.0",
    "jose": "^5.0.0",
    "ml-matrix": "^6.12.1",
    "pinia": "^2.2.0",
    "zod": "^4.1.12",
    "zod-class": "^0.0.18",
    "zod-config": "^1.4.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@vue-flow/core": {
      "optional": true
    },
    "graphology-shortest-path": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue-flow/core": "^1.48.1",
    "graphology-shortest-path": "^2.1.0",
    "tsup": "^8.0.0",
    "typescript": "~5.8.0",
    "vue": "^3.5.18"
  }
}
