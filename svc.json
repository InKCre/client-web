{
  "schema_version": 2,
  "svc_version": "10.0.1",
  "dev": {
    "profile": "local",
    "profiles": {
      "local": {
        "targets": {
          "database": {
            "scope": "worktree",
            "probe": {
              "kind": "exec",
              "argv": ["node", "scripts/probe-database.mjs", "${dev.instance}"],
              "cwd": ".",
              "timeout": 5,
              "output_limit": 2048
            },
            "provision": {
              "kind": "exec",
              "mode": "run",
              "argv": ["node", "scripts/database-runtime.mjs", "ensure", "${dev.instance}"],
              "cwd": "."
            },
            "readiness_timeout": 180,
            "poll_interval": 1
          },
          "web": {
            "scope": "worktree",
            "probe": {
              "kind": "exec",
              "argv": ["node", "scripts/probe-dev.mjs", "web", "${dev.instance}"],
              "cwd": ".",
              "timeout": 5,
              "output_limit": 1024
            },
            "provision": {
              "kind": "exec",
              "mode": "run",
              "argv": ["node", "scripts/dev.mjs", "web"],
              "cwd": "."
            },
            "access": ["https://client-web-${dev.instance}.localhost/"],
            "readiness_timeout": 90,
            "poll_interval": 0.5
          },
          "webext": {
            "scope": "worktree",
            "probe": {
              "kind": "exec",
              "argv": ["node", "scripts/probe-dev.mjs", "webext", "${dev.instance}"],
              "cwd": ".",
              "timeout": 5,
              "output_limit": 1024
            },
            "provision": {
              "kind": "exec",
              "mode": "run",
              "argv": ["node", "scripts/dev.mjs", "webext"],
              "cwd": "."
            },
            "access": ["https://webext-${dev.instance}.localhost/popup.html"],
            "readiness_timeout": 120,
            "poll_interval": 0.5
          }
        }
      }
    }
  }
}
